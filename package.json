{
  "name": "dsh-cost-crystal",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh web) 成本潮汐观测插件:余额卡片、波峰/低峰状态与切换倒计时、近24h消耗、本会话费用,以及(后续)用量预测。",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-scripts.mjs && tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test && node scripts/check-lines.mjs",
    "build:profile": "node scripts/build-profile.mjs",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "balance",
    "cost",
    "usage",
    "peak",
    "off-peak"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
